# Copy this file to .env and fill in real values.
# Never commit .env — it's already in .gitignore.

# --- Gemini / Google Cloud ---
GEMINI_API_KEY=your_key_here
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here

# --- ClickHouse ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# --- Image Generation Model (fill in once locked) ---
IMAGE_MODEL_API_KEY=

# --- App Config ---
PORT=8080
API_KEY_SECRET=your_own_endpoint_protection_key_here
