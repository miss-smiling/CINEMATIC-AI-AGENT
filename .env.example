# ════════════════════════════════════════════════════════════════
# Agentic Cinema — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# ════════════════════════════════════════════════════════════════

# ── Gemini API (Phase 1 — required from Day 1) ──────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Cloud Project (Phase 1 — required from Day 1) ────────
# Your GCP project ID (not the name, the ID)
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1

# ── Image Generation Model (locked by team Day 1) ───────────────
# Options: imagen-4.0-fast-generate-001 | imagen-4.0-generate-001 | imagen-4.0-ultra-001
IMAGE_MODEL=imagen-4.0-fast-generate-001

# ── ClickHouse Cloud (Phase 3 — Member 2 provides these Week 2) ─
# Leave blank in Week 1 — MemoryClient runs in local mode
CH_HOST=
CH_PORT=8443
CH_USER=default
CH_PASSWORD=
CH_DATABASE=agentic_cinema

# ── MCP ClickHouse server (Phase 4 — wire in Week 2) ────────────
# Installed via: npx mcp-clickhouse (see README)
# The MCP server reads CH_HOST, CH_USER, CH_PASSWORD, CH_DATABASE above

# ── Cloud Run (Phase 5 — Member 4 handles this) ─────────────────
# Set by Member 4 when deploying
CLOUD_RUN_SERVICE_URL=

# ── Secret Manager (Phase 5) ────────────────────────────────────
# Set to "true" in production to pull secrets from GCP Secret Manager
# Set to "false" in local dev to read from .env directly
USE_SECRET_MANAGER=false
GCP_SECRET_PROJECT=your_project_id_here
